# Silicium AI OS: environment variable NAMES (proposed). Copy to `.env` (git-ignored) and fill locally.
# Never commit real values. Never paste real values into prompts, issues, PRs, n8n exports or logs.
# Variable names below are proposals for Phase 2; rename in an ADR if a better convention emerges.

# --- OpenRouter (free-tier models today). Key is created in the OpenRouter dashboard. ---
OPENROUTER_API_KEY=
SILICIUM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Silicium service (n8n and OpenClaw call this; it is NOT exposed beyond loopback by default) ---
SILICIUM_SERVICE_TOKEN=
SILICIUM_SERVICE_BIND=127.0.0.1
SILICIUM_SERVICE_PORT=8787

# --- Dedicated Telegram APPROVAL bot (must be a different bot from the one OpenClaw uses) ---
TELEGRAM_APPROVAL_BOT_TOKEN=
TELEGRAM_FOUNDER_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Local endpoints (not secret) ---
N8N_BASE_URL=http://localhost:5678
OPENCLAW_BASE_URL=http://localhost:59048

# --- Runtime data location. Keep OUTSIDE any OneDrive/Dropbox-synced folder. ---
SILICIUM_DATA_DIR=
