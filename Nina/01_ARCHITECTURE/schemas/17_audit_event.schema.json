{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliciumstore.com/schemas/ai-os/v1/17_audit_event.schema.json",
  "title": "AuditEvent",
  "description": "Append-only immutable audit log entry emitted by the Tool Gateway and Control Plane for every significant action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "environment",
    "agent",
    "action",
    "tool",
    "domain",
    "resource",
    "inputs_summary",
    "outputs_summary",
    "risk_level",
    "autonomy_level",
    "outcome",
    "duration_ms"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^AUD-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^TASK-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "inputs_summary": {
      "type": "object",
      "description": "Redacted summary; secrets and sensitive PII stripped prior to logging."
    },
    "outputs_summary": {
      "type": "object"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "safe",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "autonomy_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "blocked",
        "rollback"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
