{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliciumstore.com/schemas/ai-os/v1/13_creative_asset.schema.json",
  "title": "CreativeAsset",
  "description": "Platform-native creative package generated by the Creative Content Engine with explicit QA, fact-check, and approval provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "brief_id",
    "product_truth_refs",
    "platform",
    "asset_type",
    "status",
    "content",
    "brand_bible_compliant",
    "fact_check_passed",
    "platform_native_check",
    "duplicate_concept_check",
    "created_at"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^CAST-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "brief_id": {
      "type": "string",
      "pattern": "^CBRF-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "product_truth_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PROD-[A-Z0-9-]+$"
      },
      "minItems": 1,
      "description": "ProductTruth records verified against Level 3-4 sources at generation time."
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram_reel",
        "instagram_carousel",
        "instagram_story",
        "facebook",
        "tiktok"
      ]
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "copy",
        "visual_direction",
        "video_direction",
        "full_package"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "qa_passed",
        "qa_failed",
        "awaiting_approval",
        "approved",
        "published",
        "rejected",
        "archived"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hooks",
        "headline",
        "body",
        "cta",
        "hashtags"
      ],
      "properties": {
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "cta": {
          "type": "string",
          "minLength": 1
        },
        "pinned_comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_screen_text": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timestamp_sec",
              "text"
            ],
            "properties": {
              "timestamp_sec": {
                "type": "number",
                "minimum": 0
              },
              "duration_sec": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "voiceover_script": {
          "type": [
            "string",
            "null"
          ]
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carousel_slides": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slide_number",
              "role",
              "headline",
              "body",
              "alt_text"
            ],
            "properties": {
              "slide_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "role": {
                "type": "string",
                "enum": [
                  "cover",
                  "body",
                  "cta"
                ]
              },
              "headline": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "alt_text": {
                "type": "string"
              }
            }
          }
        },
        "story_frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_number",
              "visual_text",
              "interactive_element"
            ],
            "properties": {
              "frame_number": {
                "type": "integer",
                "minimum": 1
              },
              "visual_text": {
                "type": "string"
              },
              "interactive_element": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "link_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "visual_concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "shot_list": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot_number",
              "framing",
              "action",
              "shoot_feasibility"
            ],
            "properties": {
              "shot_number": {
                "type": "integer",
                "minimum": 1
              },
              "framing": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "duration_sec": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "shoot_feasibility": {
                "type": "string",
                "enum": [
                  "in_house_achievable",
                  "aspirational_studio"
                ]
              }
            }
          }
        },
        "b_roll": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_framing": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "art_direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_gen_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "video_gen_prompt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "brand_bible_compliant": {
      "type": "boolean"
    },
    "fact_check_passed": {
      "type": "boolean"
    },
    "platform_native_check": {
      "type": "boolean"
    },
    "duplicate_concept_check": {
      "type": "boolean"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
