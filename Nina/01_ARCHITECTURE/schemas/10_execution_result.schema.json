{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliciumstore.com/schemas/ai-os/v1/10_execution_result.schema.json",
  "title": "ExecutionResult",
  "description": "Typed, verifiable result returned by the Tool Gateway for every tool invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "task_id",
    "tool_name",
    "agent",
    "inputs_hash",
    "outputs",
    "status",
    "duration_ms",
    "verified",
    "executed_at"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "pattern": "^EXE-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "inputs_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outputs": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "partial",
        "rollback",
        "blocked"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model_used": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "verified": {
      "type": "boolean"
    },
    "verification_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
